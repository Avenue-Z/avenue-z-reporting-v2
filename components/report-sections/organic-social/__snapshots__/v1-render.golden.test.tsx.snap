exports[`v1 engagement graph, one channel toggled off, then all of them 2`] = `"<section class="space-y-3"><h2 class="text-sm font-extrabold uppercase tracking-widest text-text-muted">Engagement Over Time</h2><div class="flex flex-wrap gap-2"><button type="button" class="flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold transition-colors border-white/[0.08] text-text-muted hover:text-white"><span class="h-2 w-2 rounded-full" style="background-color: transparent; border: 1px solid rgb(96, 253, 255);"></span>Instagram</button><button type="button" class="flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold transition-colors border-white/[0.08] text-text-muted hover:text-white"><span class="h-2 w-2 rounded-full" style="background-color: transparent; border: 1px solid rgb(57, 160, 255);"></span>Facebook</button><button type="button" class="flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold transition-colors border-white/[0.08] text-text-muted hover:text-white"><span class="h-2 w-2 rounded-full" style="background-color: transparent; border: 1px solid rgb(255, 138, 61);"></span>X</button><button type="button" class="flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold transition-colors border-white/[0.08] text-text-muted hover:text-white"><span class="h-2 w-2 rounded-full" style="background-color: transparent; border: 1px solid rgb(155, 123, 255);"></span>LinkedIn</button></div><div class="rounded-lg border border-white/[0.06] bg-bg-surface p-6 text-sm text-text-muted">No data for this period.</div></section>"`;

