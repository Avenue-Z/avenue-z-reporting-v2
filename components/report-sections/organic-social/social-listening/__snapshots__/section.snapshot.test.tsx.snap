exports[`Social Listening markup, pinned before the design kit move > staff, industry 1`] = `"<div class="root"><div class="topics"><div class="topics" role="group" aria-label="Topic"><button type="button" class="pill" aria-pressed="false"><span class="dot" style="background: rgb(96, 253, 255);"></span>Brand: Made Up Brand</button><button type="button" class="pill" aria-pressed="true"><span class="dot" style="background: rgb(96, 52, 255);"></span>Industry: Made Up Industry</button></div><span class="hint">Talkwalker topics: Made Up Brand, and Made Up Industry</span><span class="spacer"></span><button type="button" class="btn" aria-pressed="false">Preview as client</button></div><div class="view"><div class="slot"><span class="whoTag">Staff only</span><h4>Upload a new industry export for October 2026</h4><p>The Talkwalker .xls export as downloaded, for this month and this topic.</p><label class="editRow"><input accept=".xls,application/vnd.ms-excel" aria-label="Upload a new industry export for October 2026" type="file"></label></div><section class="section"><div class="secHead"><h2>Data</h2><span>The industry topic is a 10% sample of the conversation, by design.</span></div><div class="grid g4"><div class="kpi" data-export-block=""><p class="t">Results</p><p class="v">397</p><p class="d"><span class="flat">n/a vs Sep report</span></p><p class="s">397 exact</p></div><div class="kpi" data-export-block=""><p class="t">Positive</p><p class="v">21.9%</p><p class="d"><span class="flat">n/a vs Sep report</span></p></div><div class="kpi" data-export-block=""><p class="t">Neutral</p><p class="v">47.4%</p><p class="d"><span class="flat">n/a vs Sep report</span></p></div><div class="kpi" data-export-block=""><p class="t">Negative</p><p class="v">30.7%</p><p class="d"><span class="flat">n/a vs Sep report</span></p></div></div><div data-box="i-kpis"></div></section><section class="section"><div class="card" data-export-block=""><div class="cardHead"><h3>Results over time</h3><spa