exports[`Social Listening markup, pinned before the design kit move > export, brand 1`] = `"<div class="root"><div class="section"><h2>Brand: Made Up Brand</h2></div><div class="view"><section class="section"><h2>Data</h2><div class="grid g4"><div class="kpi" data-export-block=""><p class="t">Results</p><p class="v">397</p><p class="d"><span class="flat">n/a vs Sep report</span></p></div><div class="kpi" data-export-block=""><p class="t">Unique authors</p><p class="v">41</p><p class="d"><span class="flat">n/a vs Sep report</span></p></div><div class="kpi" data-export-block=""><p class="t">Engagement</p><p class="v">1.2K</p><p class="d"><span class="flat">n/a vs Sep report</span></p><p class="s">1,235 exact</p></div><div class="kpi" data-export-block=""><p class="t">Potential reach</p><p class="v">987.7K</p><p class="d"><span class="flat">n/a vs Sep report</span></p><p class="s">987,654 exact</p></div></div></section><section class="section"><div class="card" data-export-block=""><div class="cardHead"><h3>Results over time</h3><span class="meta">397 results</span></div><div class="cardBody"><svg viewBox="0 0 960 240" role="img" aria-label="Results per day, peak 16 on Oct 7"><defs><linearGradient id="sl-gb" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#60FDFF" stop-opacity="0.35"></stop><stop offset="1" stop-color="#60FDFF" stop-opacity="0"></stop></linearGradient></defs><line class="gridLine" x1="48" x2="944" y1="210" y2="210"></line><text class="tMuted" x="40" y="214" font-size="11" text-anchor="end">0</text><line class="gridLine" x1="48" x2="944" y1="163.5" y2="163.5"></line><text class="tMuted" x="40" y="167.5" font-size="11" text-anchor="end">5</text><line class="gridLine" x1="48" x2="944" y1="117" y2="117"></line><text class="tMuted" x="40" y="121" font-size="11" text-anchor="end">10</text><line class="gridLine" x1="48" x2="944" y1="70.5" y2="70.5"></line><text class="tMuted" x="40" y="74.5" font-size="11" text-anchor="end">15</text><line class="grid