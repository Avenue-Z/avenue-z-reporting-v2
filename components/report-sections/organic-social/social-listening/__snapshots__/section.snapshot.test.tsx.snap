/td></tr><tr><td><b>Test Author Two</b></td><td>Reddit</td><td class="r">4</td><td class="r"><span class="flat">new</span></td><td><span class="mini" role="img" aria-label="1 positive, 1 neutral, 2 negative"><i style="width: 25%; background: rgb(96, 255, 128);"></i><i style="width: 25%; background: rgb(255, 252, 96);"></i><i style="width: 50%; background: rgb(255, 68, 68);"></i></span></td><td class="r">300</td><td class="r">8</td></tr></tbody></table></div></div><div class="inCard"><div data-box="b-authors"></div></div></div></section><section class="section"><h2>Most relevant posts</h2><div data-box="b-posts"></div></section><section class="section"><h2>Key takeaways</h2><div data-export-block=""><div data-box="b-takeaways"></div></div></section><section class="section"><h2>Keyword appendix</h2><div data-export-block=""><div data-box="b-keywords"></div></div></section><p class="source">Source: Talkwalker export of the topic "Made Up Brand", October 1 to 31, 2026 (Eastern). Changes compare with the September report as presented to the client.</p></div></div>"`;

