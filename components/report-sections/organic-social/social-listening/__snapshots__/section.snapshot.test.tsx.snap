segPill">49.4%</b></i><i style="width: 32.91139240506329%; background: rgb(255, 69, 0);" title="Reddit: 32.9%"><b class="segPill">32.9%</b></i><i style="width: 17.72151898734177%; background: rgb(156, 163, 175);" title="News: 17.7%"><b class="segPill">17.7%</b></i></div></div></div><div class="key"><span><i style="background: rgb(255, 107, 138);"></i>Instagram</span><span><i style="background: rgb(255, 69, 0);"></i>Reddit</span><span><i style="background: rgb(156, 163, 175);"></i>News</span></div></div></div></section><section class="section"><h2>Themes</h2><div class="card" data-export-block=""><div class="cardHead"><h3>Keyword themes</h3><span class="meta">Size = share of results</span></div><div class="cardBody"><div class="cloud" aria-label="Keyword themes"><span style="font-size: 13px; color: rgb(255, 68, 68);" title="cloud harbor: 6.3% of results">cloud harbor</span><span style="font-size: 32px; color: rgb(96, 255, 128);" title="apple orchard: 25.0% of results">apple orchard</span><span style="font-size: 24px; color: rgb(255, 252, 96);" title="river stone: 12.5% of results">river stone</span></div><div class="key"><span><i style="background: rgb(96, 255, 128);"></i>Mostly positive</span><span><i style="background: rgb(255, 252, 96);"></i>Mostly neutral</span><span><i style="background: rgb(255, 68, 68);"></i>Mostly negative</span></div></div></div></section><section class="section"><h2>Top influencers</h2><div class="grid g4"><div class="ov" data-export-block=""><p class="t">Most active author</p><p class="who">AuthorA</p><p class="net">instagram</p><p class="val">12 results</p></div><div class="ov" data-export-block=""><p class="t">Most influential author</p><p class="who">AuthorB</p><p class="net">reddit</p><p class="val">3.4K reach</p></div><div class="ov" data-export-block=""><p class="t">Most active site</p><p class="who">site-a.example</p><p class="net">news</p><p class="val">9 results</p></div><div class="ov" data-export-block=""><p class="t">Most influential site</p><p class="who">site-b.example</p><p class="net">news</p><p class="val">45.0K reach</p></div></div><div class="card" data-export-block=""><div class="cardHead"><h3>Top 2 authors</h3><span class="meta">Posts, sentiment, reach and engagement</span></div><div class="cardBody"><div class="tableScroll"><table class="table authorsTable"><thead><tr><th>Author</th><th>Network</th><th class="r">Posts</th><th class="r">vs Sep</th><th>Sentiment</th><th class="r">Reach</th><th class="r">Reach per mention</th><th class="r">Engagement</th><th class="r">Engagement per mention</th></tr></thead><tbody><tr><td><b>Test Author One</b></td><td>Instagram</td><td class="r">6</td><td class="r"><span class="flat">new</span></td><td><span class="mini" role="img" aria-label="3 positive, 2 neutral, 1 negative"><i style="width: 50%; background: rgb(96, 255, 128);"></i><i style="width: 33.333333333333336%; background: rgb(255, 252, 96);"></i><i style="width: 16.666666666666668%; background: rgb(255, 68, 68);"></i></span></td><td class="r">5.0K</td><td class="r">833</td><td class="r">121</td><td class="r">20.1</td></tr><tr><td><b>Test Author Two</b></td><td>Reddit</td><td class="r">4</td><td class="r"><span class="flat">new</span></td><td><span class="mini" role="img" aria-label="1 positive, 1 neutral, 2 negative"><i style="width: 25%; background: rgb(96, 255, 128);"></i><i style="width: 25%; background: rgb(255, 252, 96);"></i><i style="width: 50%; background: rgb(255, 68, 68);"></i></span></td><td class="r">300</td><td class="r">75</td><td class="r">8</td><td class="r">2</td></tr></tbody></table></div></div></div></section><p class="source">Source: Talkwalker export of the topic "Made Up Brand", October 1 to 31, 2026 (Eastern). Changes compare with the September report as presented to the client.</p></div></div>"`;

exports[`Social Listening markup, pinned before the design kit move > export, industry 1`] = `"<div class="root"><div class="section"><h2>Industry: Made Up Industry</h2></div><div class="view"><section class="section"><div class="secHead"><h2>Data</h2><span>The industry topic is a 10% sample of the conversation, by design.</span></div><div class="grid g4"><div class="kpi" data-export-block=""><p class="t">Results</p><p class="v">397</p><p class="d"><span class="flat">n/a vs Sep report</span></p><p class="s">397 exact</p></div><div class="kpi" data-export-block=""><p class="t">Positive</p><p class="v">21.9%</p><p class="d"><span class="flat">n/a vs Sep report</span></p></div><div class="kpi" data-export-block=""><p class="t">Neutral</p><p class="v">47.4%</p><p class="d"><span class="flat">n/a vs Sep report</span></p></div><div class="kpi" data-export-block=""><p class="t">Negative</p><p class="v">30.7%</p><p class="d"><span class="flat">n/a vs Sep report</span></p></div></div></section><section class="section"><div class="card" data-export-block=""><div class="cardHead"><h3>Results over time</h3><span class="meta">397 results</span></div><div class="cardBody"><svg viewBox="0 0 960 240" role="img" aria-label="Results per day, peak 16 on Oct 7"><defs><linearGradient id="sl-gi" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#A08BFF" stop-opacity="0.35"></stop><stop offset="1" stop-color="#A08BFF" stop-opacity="0"></stop></linearGradient></defs><line class="gridLine" x1="48" x2="944" y1="210" y2="210"></line><text class="tMuted" x="40" y="214" font-size="11" text-anchor="end">0</text><line class="gridLine" x1="48" x2="944" y1="163.5" y2="163.5"></line><text class="tMuted" x="40" y="167.5" font-size="11" text-anchor="end">5</text><line class="gridLine" x1="48" x2="944" y1="117" y2="117"></line><text class="tMuted" x="40" y="121" font-size="11" text-anchor="end">10</text><line class="gridLine" x1="48" x2="944" y1="70.5" y2="70.5"></line><text class="tMuted" x="40