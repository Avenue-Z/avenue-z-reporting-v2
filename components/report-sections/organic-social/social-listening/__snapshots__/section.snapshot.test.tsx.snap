iv><div class="cardBody"><div class="cloud" aria-label="Keyword themes"><span style="font-size: 13px; color: rgb(96, 253, 255);" title="cloud harbor: 6.3% of results">cloud harbor</span><span style="font-size: 32px; color: rgb(57, 160, 255);" title="apple orchard: 25.0% of results">apple orchard</span><span style="font-size: 24px; color: rgb(160, 139, 255);" title="river stone: 12.5% of results">river stone</span></div></div><p class="note">Colour is decoration on the industry cloud. It does not mean sentiment.</p></div></section><p class="source">Source: Talkwalker export of the topic "Made Up Industry", October 1 to 31, 2026 (Eastern). Changes compare with the September report as presented to the client.</p></div></div>"`;

exports[`Social Listening markup, pinned before the design kit move > staff, brand 1`] = `"<div class="root"><div class="topics"><div class="topics" role="group" aria-label="Topic"><button type="button" class="pill" aria-pressed="true"><span class="dot" style="background: rgb(96, 253, 255);"></span>Brand: Made Up Brand</button><button type="button" class="pill" aria-pressed="false"><span class="dot" style="background: rgb(96, 52, 255);"></span>Industry: Made Up Industry</button></div><span class="hint">Talkwalker topics: Made Up Brand, and Made Up Industry</span><span class="spacer"></span><button type="button" class="btn" aria-pressed="false">Preview as client</button></div><div class="view"><div class="slot"><span class="whoTag">Staff only</span><h4>Upload a new brand export for October 2026</h4><p>The Talkwalker .xls export as downloaded, for this month and this topic.</p><label class="editRow"><input accept=".xls,application/vnd.ms-excel" aria-label="Upload a new brand export for October 2026" type="file"></label></div><section class="section"><h2>Data</h2><div class="grid g4"><div class="kpi" data-export-block=""><p class="t">Results</p><p class="v">397</p><p class="d"><span class="flat">n/a vs Sep report</span></p></div><div class="kpi" data-export-block=""><p class="t">Unique authors</p><p class="v">41</p><p class="d"><span class="flat">n/a vs Sep report</span></p></div><div class="kpi" data-export-block=""><p class="t">Engagement</p><p class="v">1.2K</p><p class="d"><span class="flat">n/a vs Sep report</span></p><p class="s">1,235 exact</p></div><div class="kpi" data-export-block=""><p class="t">Potential reach</p><p class="v">987.7K</p><p class="d"><span class="flat">n/a vs Sep report</span></p><p class="s">987,654 exact</p></div></div><div data-box="b-kpis"></div></section><section class="section"><div class="card" data-export-block=""><div class="cardHead"><h3>Results over time</h3><span class="meta">397 results</span></div><div class="cardBody"><svg view