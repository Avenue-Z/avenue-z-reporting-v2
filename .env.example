# ─────────────────────────────────────────────────────────────────────────────
# Avenue Z Reporting Platform — environment template
#
# Copy to .env.local and fill in values:   cp .env.example .env.local
# Get real values from the team or the Vercel project settings (Production /
# Preview scopes). NEVER commit .env.local or real secrets — only this template.
#
# Legend:
#   [required]    app won't run / a core feature breaks without it
#   [per-client]  one var per client; the DB stores only the var NAME, not the value
#   [optional]    feature- or dev-only; safe to leave blank
#   [vercel]      auto-injected by Vercel in deploys; set locally only to test that path
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth.js v5 ───────────────────────────────────────────────────────────────
AUTH_SECRET=                        # [required] openssl rand -base64 32
AUTH_GOOGLE_ID=                     # [required] Google Cloud OAuth 2.0 client id
AUTH_GOOGLE_SECRET=                 # [required] same credential
AUTH_TRUST_HOST=true                # [required in Preview/Prod] NextAuth v5 host trust

# Preview-only test admin (credentials-login bypass). Inert in Production —
# gated on VERCEL_ENV !== 'production'. Leave blank locally unless testing it.
TEST_ADMIN_EMAIL=                   # [optional]
TEST_ADMIN_PASSWORD=                # [optional]

# ── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # [required] public base URL
APP_URL=http://localhost:3000               # [required] server-side base URL

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
# Point these at the DEV Neon project locally. In Vercel, scope Production and
# Preview separately (Preview → dev DB). See ENGINEERS.md → "Vercel scoping".
DATABASE_URL=                       # [required] pooled connection (app runtime)
DATABASE_URL_UNPOOLED=              # [required] direct connection (drizzle-kit migrations)

# ── Google service account (shared: GA4 + GSC + Sheets/Drive readers) ─────────
GOOGLE_SERVICE_ACCOUNT_KEY=         # [required] base64-encoded service-account JSON
GSC_IMPERSONATE_EMAIL=             # [required for GSC] domain-wide-delegation user the SA impersonates
# Alternative credential path read by the settings/status page (both optional):
GOOGLE_APPLICATION_CREDENTIALS_JSON=   # [optional] inline JSON
GOOGLE_APPLICATION_CREDENTIALS=        # [optional] path to a key file

# ── BigQuery + Gemini (AI data-chat / conversational summary) ─────────────────
BQ_PROJECT_ID=                      # [optional]
BQ_DATASET=                         # [optional]

# ── Peec AI (AI brand-visibility; multi-tenant key, per-client project ids in DB) ─
PEEC_AI_CUSTOMER_TOKEN=             # [required for Peec] "skc-..." multi-tenant key
PEEC_AI_PROJECT_ID=                # [optional] legacy fallback for callers without a clientSlug
PEEC_AI_YOUR_BRAND=                # [optional] legacy fallback for clients.peec_your_brand

# ── Profound AI (AI brand-visibility) ────────────────────────────────────────
PROFOUND_AI_ACCESS_TOKEN=          # [required for Profound]
PROFOUND_CATEGORY_ID=              # [optional] legacy fallback for clients.profound_category_id
PROFOUND_AI_YOUR_BRAND=            # [optional] legacy fallback

# ── News API (PR placements / earned media) ──────────────────────────────────
NEWSAPI_AI_KEY=                     # [required for PR placements] newsapi.ai key (NOTE: var is NEWSAPI_AI_KEY)

# ── Glean (internal meeting-prep brief) ──────────────────────────────────────
GLEAN_INSTANCE=                     # [optional] Glean instance name
GLEAN_API_TOKEN=                    # [optional] Glean API token

# ── Triple Whale (e-commerce; configurable-dashboard adapter + reports) ───────
TRIPLE_WHALE_API_KEY=               # [optional]

# ── Dash Social (organic-social source) ──────────────────────────────────────
DASH_API_TOKEN=                     # [optional] shared token; per-client brandId lives in the DB

# ── Shopify (per-client OAuth app; one id/secret pair per Shopify client) ─────
SHOPIFY_KIND_PATCHES_CLIENT_ID=        # [per-client]
SHOPIFY_KIND_PATCHES_CLIENT_SECRET=    # [per-client]

# ── HubSpot (per-client secret; DB clients.hubspot_token_env_var stores the NAME) ─
# Add one var per HubSpot client, named to match the DB pointer, e.g.:
HUBSPOT_ACCESS_TOKEN_AVENUE_Z=      # [per-client] "pat-na1-..."

# ── Supermetrics (per-client Data API key; DB clients.sm_api_key_env_var stores the NAME) ─
# Add one var per client using Supermetrics-backed paid/social sections, e.g.:
# SUPERMETRICS_API_KEY_AVENUE_Z=    # [per-client]

# ── Health alerting (Slack) ──────────────────────────────────────────────────
SLACK_BOT_TOKEN=                    # [optional] xoxb-... bot token, chat:write scope
SLACK_CHANNEL_ID=                   # [optional] internal health channel id, e.g. C0123ABCD

# ── Cron / cache warming ─────────────────────────────────────────────────────
CRON_SECRET=                        # [required for cron routes] bearer secret for cache-warm + health sweep
CACHE_WARM_BASE_URL=                # [optional] base URL the cache-warm script targets

# ── Vercel-provided (auto-set in deploys; set locally only to exercise these paths) ─
# VERCEL_ENV=                       # [vercel] 'production' | 'preview' | 'development'
# VERCEL_URL=                       # [vercel] deployment URL

# ── Dev / performance toggles (all optional) ─────────────────────────────────
CACHE_DISABLE=                      # [optional] set '1' to bypass the vendor cache
PERF_LOG=                           # [optional] set '1' to log timing to perf.log
PERF_BASE_URL=                      # [optional] perf harness target
PERF_SESSION_COOKIE=                # [optional] perf harness auth cookie
PERF_DATE_RANGE=                    # [optional] perf harness date range
